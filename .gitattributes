# Line endings are normalised to LF inside the repository. `.editorconfig` asks
# editors; this line is enforced by git and works from the committed file alone.
* text=auto eol=lf

# Lockfiles are written by machines. `linguist-generated` makes GitHub fold them
# in diffs so review reads the changed line in pyproject.toml, not hundreds of
# lockfile lines. They still count in `ci / diff-size`; that is a separate meter.
uv.lock linguist-generated
