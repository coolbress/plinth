{
  "config": {
    "MD013": false,
    // Keep a Changelog repeats "### Added" under every version; siblings must still differ.
    "MD024": { "siblings_only": true },
    // The README's mark is centred: <p align="center"><img>. No other element is allowed (#1268).
    "MD033": { "allowed_elements": ["p", "img"] }
  },
  "ignores": [
    ".scratch/**",
    // plinth-template's render, committed for the canary-template job (#953); the template lints its own.
    "canary-template/**",
    // A pull-request template starts at "##": the pull request's title is its heading (MD041).
    ".github/PULL_REQUEST_TEMPLATE.md"
  ]
}
