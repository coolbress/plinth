{
  "config": {
    "MD013": false,
    // Keep a Changelog repeats "### Added" under every version; siblings must still differ.
    "MD024": { "siblings_only": true }
  },
  "ignores": [
    ".scratch/**",
    // A pull-request template starts at "##": the pull request's title is its heading (MD041).
    ".github/PULL_REQUEST_TEMPLATE.md"
  ]
}
