# Python
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Jupyter's autosaves beside a notebook; the notebook itself is committed
.ipynb_checkpoints/

# Coverage reports, from a local run or CI
.coverage
coverage.xml
htmlcov/

# Real values are never committed; only .env.example is.
.env
.env.*
!.env.example

# Django's local database (the web archetype, when DATABASE_URL is unset) and
# its collected static files
db.sqlite3
staticfiles/

# Logs, exported tables and screenshots carry real data, paths and tokens;
# on a public repository a commit publishes them. A table a test reads lives
# under tests/, and data/ keeps its own rules. A CSV a package ships stays
# under src/: ignoring it would leave it out of the build without a word.
# Screenshots only at the top level, where one dropped into the project lands:
# one under docs/ or src/ is meant to be there.
*.log
*.csv
!/tests/**/*.csv
!/src/**/*.csv
/[Ss]creenshot*
/Screen Shot*

# OS
.DS_Store

# Claude Code's personal settings. Only .claude/settings.json is committed:
# Claude Code adds this file to the global git excludes of one machine, which
# protects that machine and not the repository.
.claude/settings.local.json
# A worktree under here is another checkout, not content: `git add .` would
# otherwise stage it as a gitlink.
.claude/worktrees/
